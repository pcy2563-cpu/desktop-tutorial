@keyframes pageDrift{0%{background-position:0 0,100%,0,50%0}to{background-position:8% 10%,92% 4%,50% 100%}}@keyframes riseIn{0%{opacity:0;transform:translateY(18px) scale(.985)}to{opacity:1;transform:translateY(0) scale(1)}}@keyframes sheenSweep{0%{transform:translateX(-135%) skewX(-18deg);opacity:0}18%{opacity:.22}40%{opacity:.1}to{transform:translateX(210%) skewX(-18deg);opacity:0}}@keyframes softGlow{0%,to{box-shadow:0 16px 28px rgba(249,115,22,.34);transform:translateY(0)}50%{box-shadow:0 20px 34px rgba(249,115,22,.42);transform:translateY(-2px)}}@keyframes activePillGlow{0%,to{box-shadow:0 4px 14px rgba(79,70,229,.4)}50%{box-shadow:0 8px 22px rgba(79,70,229,.3)}}@keyframes slowZoom{0%{transform:scale(1.02)}to{transform:scale(1.09)}}@keyframes revealUp{0%{opacity:0;transform:translate3d(0,28px,0) scale(.985)}to{opacity:1;transform:translate3d(0,0,0) scale(1)}}@keyframes lineDraw{0%{stroke-dashoffset:1200}to{stroke-dashoffset:0}}@keyframes pointPop{0%{opacity:0;transform:scale(.4)}to{opacity:1;transform:scale(1)}}@keyframes meterGrowX{0%{transform:scaleX(0)}to{transform:scaleX(var(--bar-scale, 1))}}@keyframes meterGrowY{0%{transform:scaleY(0)}to{transform:scaleY(var(--column-scale, 1))}}@keyframes pulseRise{0%{transform:scaleX(0)}to{transform:scaleX(var(--pulse-scale, 1))}}@keyframes chipRise{0%{opacity:0;transform:translateY(14px) scale(.92) rotate(-3deg)}to{opacity:1;transform:translateY(0) scale(1) rotate(0deg)}}@keyframes orbitRotate{0%{transform:rotate(0deg)}to{transform:rotate(360deg)}}@keyframes orbitRotateReverse{0%{transform:rotate(360deg)}to{transform:rotate(0deg)}}@keyframes orbitPulse{0%,to{transform:scale(.98);opacity:.78}50%{transform:scale(1.03);opacity:1}}@keyframes floatDrift{0%,to{transform:translate3d(0,0,0)}50%{transform:translate3d(0,-7px,0)}}@keyframes bounce{0%,80%,to{transform:scale(.55);opacity:.45}40%{transform:scale(1);opacity:1}}@keyframes toastIn{0%{opacity:0;transform:translateX(-50%) translateY(12px)}12%,88%{opacity:1;transform:translateX(-50%) translateY(0)}to{opacity:0;transform:translateX(-50%) translateY(-8px)}}@keyframes forumAura{0%{background-position:0 0,100%,0,50%0}to{background-position:7% 9%,92% 5%,50% 100%}}@keyframes pageReveal{0%{opacity:0;transform:translateY(18px) scale(.985)}to{opacity:1;transform:translateY(0) scale(1)}}@keyframes qxDialogPop{0%{opacity:0;transform:translateY(18px) scale(.96)}to{opacity:1;transform:translateY(0) scale(1)}}:root{--bg:#f6f5f1;--bg-soft:#eef4f7;--surface:rgba(255, 255, 255, 0.78);--card:#fffefd;--text:#0f172a;--muted:#667085;--line:rgba(148, 163, 184, 0.18);--brand:#0f766e;--brand-2:#0284c7;--accent:#f97316;--danger:#dc2626;--radius:18px;--shadow:0 18px 48px rgba(15, 23, 42, 0.08);--font:'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', 'Noto Sans CJK SC', system-ui, sans-serif}*{margin:0;padding:0;box-sizing:border-box}body{font-family:var(--font);min-height:100vh;padding-bottom:calc(92px + env(safe-area-inset-bottom,0));background:radial-gradient(780px 460px at 8% -8%,rgba(17,103,94,.17),transparent 62%),radial-gradient(680px 420px at 100% 4%,rgba(215,123,56,.13),transparent 58%),linear-gradient(145deg,#fbf8ef 0,#eff4f0 48%,#eaf2f4 100%);color:var(--text)}#appShell::after,#appShell::before,body::after,body::before{content:"";position:fixed;inset:auto;pointer-events:none;z-index:-1}body::after,body::before{border-radius:50%;filter:blur(18px);opacity:.5}body::before{right:-92px;background:radial-gradient(circle,rgba(249,115,22,.14),transparent 68%)}body::after{left:-120px;background:radial-gradient(circle,rgba(15,118,110,.13),transparent 70%)}#appShell{position:relative;isolation:isolate;width:min(780px,100%);margin:0 auto}#appShell::after,#appShell::before{opacity:.6}#appShell::before{top:180px;left:min(6vw,40px);width:200px;height:200px;border-radius:34px;background:linear-gradient(145deg,rgba(99,102,241,.12),rgba(14,165,233,.04));transform:rotate(16deg);filter:blur(6px)}#appShell::after{right:min(4vw,24px);bottom:180px;width:220px;height:220px;border-radius:999px;background:radial-gradient(circle,rgba(249,115,22,.12),transparent 72%);filter:blur(10px)}body.modal-open{overflow:hidden}.role-badge{margin-left:6px;font-size:10px;font-weight:800;padding:2px 8px;vertical-align:middle;background:linear-gradient(135deg,#f59e0b,#ea580c);color:#fff}.hidden{display:none!important}.reveal-on-scroll{opacity:0;transform:translate3d(0,28px,0) scale(.985);transition:none}.reveal-on-scroll.is-visible{animation:revealUp .72s cubic-bezier(.18,.8,.22,1) both;animation-delay:var(--reveal-delay, 0ms)}.header{position:sticky;z-index:100;display:flex;align-items:center;justify-content:space-between;background:linear-gradient(135deg,rgba(9,46,68,.95),rgba(15,118,110,.94),rgba(2,132,199,.9));color:#fff;backdrop-filter:blur(12px);overflow:hidden}.header::after{content:"";position:absolute;inset:-20%auto -20% -25%;background:linear-gradient(90deg,transparent,rgba(255,255,255,.18),transparent);transform:skewX(-18deg);animation:sheenSweep 7s ease-in-out infinite;pointer-events:none}.header-page-pill{min-width:64px;padding:8px 15px;border-radius:999px;text-align:center;font-size:13px;font-weight:700;color:#fff;background:rgba(255,255,255,.14)}.app-pages{min-height:calc(100vh - 88px)}.app-page{padding-bottom:20px;animation:riseIn .45s ease both}.header-brand,.header-logo{display:flex;align-items:center}.header-brand{gap:12px}.header-logo{width:42px;height:42px;background:linear-gradient(135deg,rgba(255,255,255,.22),rgba(255,255,255,.08));justify-content:center;font-weight:700;font-size:18px;border:1px solid rgba(255,255,255,.26);position:relative;overflow:hidden}.header-logo-image,.header-logo-text{width:100%;height:100%;border-radius:inherit}.header-logo-text{display:inline-flex;align-items:center;justify-content:center}.header-logo-image{object-fit:cover;display:block}.header-logo.is-image{background:rgba(255,255,255,.1);box-shadow:0 10px 20px rgba(15,23,42,.14),inset 0 1px 0 rgba(255,255,255,.22)}.header-titles h1{font-weight:700}.header-tagline{font-size:11px;margin-top:2px;font-weight:500}.user-chip,.user-info{display:flex;align-items:center;gap:8px}.user-chip{max-width:140px}.user-chip-avatar{width:32px;height:32px;border-radius:50%;object-fit:cover;border:2px solid rgba(255,255,255,.5);flex-shrink:0}.user-chip-name{font-size:13px;font-weight:600;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.login-btn,.logout-btn{padding:8px 14px;border-radius:999px;font-size:13px;font-weight:600;cursor:pointer;border:0;background:rgba(255,255,255,.22);color:#fff;transition:background .2s,transform .15s}.login-btn:active,.logout-btn:active{transform:scale(.97)}.logout-btn{background:rgba(255,255,255,.14)}.categories{position:sticky;z-index:90;display:flex;gap:8px;overflow-x:auto;-webkit-overflow-scrolling:touch;scrollbar-width:none;background:linear-gradient(135deg,rgba(255,255,255,.86),rgba(250,252,255,.74));backdrop-filter:blur(16px)}.categories::-webkit-scrollbar{display:none}.cat-btn{flex-shrink:0;padding:9px 15px;border:1px solid transparent;background:rgba(255,255,255,.72);font-size:13px;font-weight:600;cursor:pointer;transition:color .2s,background .2s,border-color .2s,box-shadow .2s}.cat-btn:hover{color:var(--brand);border-color:rgba(79,70,229,.25)}.cat-btn.active{background:linear-gradient(135deg,var(--brand),var(--brand-2));animation:activePillGlow 2.6s ease-in-out infinite}.post-btn{margin-left:auto;background:linear-gradient(135deg,#fb923c,#f97316)!important;border:0!important;box-shadow:0 4px 14px rgba(249,115,22,.35)}.post-btn,.post-btn:hover{color:#fff!important}.search-bar-wrap{max-width:720px}.search-bar{display:flex;gap:8px;padding:11px;background:linear-gradient(135deg,rgba(255,255,255,.94),rgba(248,250,252,.9));backdrop-filter:blur(14px)}.post-search-editable,.search-bar input{flex:1;min-width:0;border:1px solid var(--line);background:#fff;padding:10px 12px;font-family:inherit;min-height:44px;display:flex;align-items:center;color:var(--text);line-height:1.4;cursor:text;user-select:text}.post-search-editable:focus,.search-bar input:focus{outline:0;border-color:var(--brand)}.post-search-editable:empty::before{content:attr(data-placeholder);color:rgba(15,23,42,.52);pointer-events:none}.search-btn{flex-shrink:0;border:0;padding:0 18px;background:linear-gradient(135deg,var(--brand),var(--brand-2));font-size:14px;font-weight:700;cursor:pointer}.page-overview-card{position:relative;overflow:hidden;isolation:isolate;max-width:720px;margin:14px auto 0;padding:18px;border-radius:24px;background:radial-gradient(circle at top right,rgba(14,165,233,.14),transparent 30%),radial-gradient(circle at bottom left,rgba(249,115,22,.12),transparent 34%),linear-gradient(145deg,rgba(255,255,255,.98),rgba(246,248,252,.94));border:1px solid rgba(255,255,255,.92);box-shadow:0 20px 44px rgba(15,23,42,.08);animation:riseIn .56s ease both}.page-overview-card::before{content:"";position:absolute;inset:0;background:linear-gradient(120deg,rgba(255,255,255,.34),transparent 28%,transparent 72%,rgba(255,255,255,.18));pointer-events:none}.page-overview-card>*{position:relative;z-index:1}.page-overview-head{display:flex;justify-content:space-between;gap:14px;align-items:flex-start}.page-overview-eyebrow{font-size:11px;font-weight:800;letter-spacing:.08em;text-transform:uppercase;color:var(--brand-2)}.page-overview-head h3{margin:6px 0 0;font-size:clamp(20px,2.8vw,24px);line-height:1.35;color:var(--text)}.page-overview-badge{flex-shrink:0;padding:10px 14px;border-radius:999px;background:rgba(15,118,110,.1);color:var(--brand);font-size:12px;font-weight:800;box-shadow:inset 0 1px 0 rgba(255,255,255,.5)}.page-overview-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px;margin-top:16px}.page-overview-item{padding:14px 15px;border-radius:18px;background:linear-gradient(145deg,rgba(255,255,255,.94),rgba(248,250,252,.88));border:1px solid rgba(226,232,240,.82);box-shadow:inset 0 1px 0 rgba(255,255,255,.6)}.page-overview-item span{display:block;color:var(--muted);font-size:12px}.page-overview-item strong{display:block;margin-top:8px;font-size:20px;line-height:1.35;color:var(--text)}.feed-overview-note,.page-overview-item small{display:block;margin-top:8px;color:var(--muted);font-size:13px;line-height:1.7}.feed-overview-card{margin-top:16px}.hero-root{position:relative;max-width:720px;border-radius:var(--radius);box-shadow:var(--shadow);animation:riseIn .65s ease both}.hero-scroller{display:flex;overflow-x:auto;height:200px;scroll-snap-type:x mandatory;scroll-behavior:smooth;-webkit-overflow-scrolling:touch;scrollbar-width:none;background:#e2e8f0}.hero-scroller::-webkit-scrollbar{display:none}.hero-card{flex:0 0 100%;height:200px;scroll-snap-align:start;position:relative;overflow:hidden;background:linear-gradient(135deg,rgba(226,232,240,.9),rgba(203,213,225,.88))}.hero-card img{width:100%;height:100%;object-fit:cover;display:block;animation:slowZoom 9s ease-in-out infinite alternate}.hero-dots{position:absolute;left:50%;transform:translateX(-50%);display:flex;justify-content:center;z-index:2}.hero-dot{border-radius:999px;border:0;padding:0;background:rgba(255,255,255,.34);cursor:pointer;box-shadow:0 2px 8px rgba(15,23,42,.12);transition:width .2s ease,background .2s ease,transform .2s ease,opacity .2s ease}.hero-dot.active{background:rgba(255,255,255,.9);transform:none}.modal-content-wide{max-width:520px}.admin-post-tools{padding:12px 0 16px;margin-bottom:12px;border-bottom:1px dashed var(--line)}.admin-post-tools-hint{font-size:12px;color:var(--muted);margin-bottom:12px}.admin-subtitle{font-size:13px;font-weight:700;color:#0f172a;margin:10px 0 8px}.admin-banner-list{max-height:none;overflow:visible;margin-bottom:12px}.admin-banner-row{display:flex;align-items:center;gap:10px;padding:10px;background:linear-gradient(145deg,rgba(248,250,252,.96),rgba(255,255,255,.92));border:1px solid rgba(226,232,240,.82);box-shadow:0 12px 26px rgba(15,23,42,.05)}.admin-banner-row+.admin-banner-row{margin-top:10px}.admin-banner-thumb{width:68px;height:44px;object-fit:cover;border-radius:12px;flex-shrink:0;box-shadow:0 10px 20px rgba(15,23,42,.12)}.admin-banner-meta{flex:1;min-width:0;font-size:13px}.admin-banner-meta small{color:var(--muted)}.admin-banner-actions{flex-shrink:0}.admin-manage-card--branding{background:radial-gradient(circle at top right,rgba(15,118,110,.14),transparent 28%),radial-gradient(circle at bottom left,rgba(2,132,199,.12),transparent 32%),rgba(255,255,255,.94)}.admin-branding-preview{display:flex;align-items:center;gap:14px;padding:14px 15px;margin-bottom:14px;border-radius:18px;background:linear-gradient(145deg,rgba(248,250,252,.92),rgba(255,255,255,.78));border:1px solid rgba(226,232,240,.88)}.admin-branding-logo{width:54px;height:54px;border-radius:18px;flex-shrink:0;box-shadow:0 16px 28px rgba(15,23,42,.12)}.admin-branding-copy{min-width:0}.admin-branding-copy strong,.profile-account-stat strong{display:block;color:var(--text);font-size:15px}.admin-branding-copy p,.profile-dashboard-entry p{margin:6px 0 0;color:var(--muted);font-size:13px;line-height:1.7}.admin-branding-actions{display:flex;gap:10px;margin-top:8px}.admin-branding-actions .admin-branding-reset,.admin-branding-actions .btn-admin-add{margin-top:0}.admin-branding-reset{width:auto;min-width:120px}.admin-toggle-row{margin:2px 0 12px}.admin-announcement-preview{display:grid;gap:12px}.admin-announcement-meta{display:flex;flex-wrap:wrap;align-items:center;gap:8px}.admin-announcement-link-badge,.admin-announcement-status{display:inline-flex;align-items:center;justify-content:center;min-height:30px;padding:0 12px;border-radius:999px;font-size:12px;font-weight:800;letter-spacing:.04em}.admin-announcement-status{background:rgba(148,163,184,.16);color:#475569}.admin-announcement-status.is-active{background:rgba(15,118,110,.12);color:var(--brand)}.admin-announcement-link-badge{background:rgba(14,165,233,.12);color:#0369a1}.admin-announcement-title,.profile-account-meta h3,.profile-dashboard-entry h3,.profile-entry-head h3{margin:0;font-size:20px;color:var(--text)}.admin-announcement-body{margin:0;color:var(--muted);line-height:1.75;white-space:pre-line}.admin-announcement-link{display:inline-flex;align-items:center;gap:6px;width:fit-content;color:var(--brand);font-weight:700;text-decoration:none}.admin-announcement-media{overflow:hidden;border-radius:22px;background:linear-gradient(145deg,rgba(226,232,240,.92),rgba(203,213,225,.84));border:1px solid rgba(226,232,240,.82);box-shadow:0 16px 28px rgba(15,23,42,.08)}.admin-announcement-media img{display:block;width:100%;max-height:260px;object-fit:cover}.btn-banner-del{padding:6px 10px;font-size:12px;border-radius:8px;border:1px solid #fecaca;background:#fef2f2;color:#b91c1c;cursor:pointer}.btn-admin-add{width:100%;margin-top:8px;padding:10px;border-radius:10px;border:0;background:linear-gradient(135deg,#6366f1,#7c3aed);color:#fff;font-weight:700;font-size:14px;cursor:pointer}.admin-mute-block{margin-top:8px}.btn-admin-search{width:100%;padding:10px;border-radius:10px;border:1px solid #cbd5f5;background:#eef2ff;color:#3730a3;font-weight:700;font-size:14px;cursor:pointer}.admin-mute-actions{display:flex;gap:8px;margin-top:8px}.admin-user-results{margin-top:10px;display:flex;flex-direction:column;gap:10px}.admin-user-row{display:flex;gap:10px;align-items:flex-start;justify-content:space-between;padding:14px;background:radial-gradient(circle at top right,rgba(14,165,233,.08),transparent 30%),linear-gradient(145deg,rgba(248,250,252,.98),rgba(255,255,255,.94));border:1px solid rgba(226,232,240,.82);box-shadow:0 16px 32px rgba(15,23,42,.06)}.admin-user-main{flex:1;min-width:0}.admin-user-name{font-size:14px;font-weight:700;color:#0f172a}.admin-user-id{margin-left:8px;font-size:12px;color:var(--muted);font-weight:600}.admin-user-meta,.admin-user-phone{margin-top:4px;font-size:12px;color:#475569;word-break:break-all}.admin-user-phone-empty{color:var(--muted)}.admin-user-tags{display:flex;flex-wrap:wrap;gap:6px;margin-top:8px}.admin-user-ta