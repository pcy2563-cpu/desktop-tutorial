tart;padding:24px;background:radial-gradient(circle at top right,rgba(79,70,229,.22),transparent 34%),radial-gradient(circle at bottom left,rgba(14,165,233,.18),transparent 30%),linear-gradient(135deg,rgba(255,255,255,.98),rgba(241,245,249,.94));position:relative;animation:riseIn .6s ease both}.dashboard-hero::after{content:"";position:absolute;inset:auto -10% -35%auto;width:220px;height:220px;border-radius:50%;background:radial-gradient(circle,rgba(255,255,255,.24),transparent 68%);filter:blur(2px);animation:pageDrift 10s ease-in-out infinite alternate;pointer-events:none}.dashboard-hero-copy{margin:10px 0 0;max-width:720px;color:var(--muted);line-height:1.8}.content-center-hero{background:radial-gradient(circle at top right,rgba(15,118,110,.22),transparent 34%),radial-gradient(circle at bottom left,rgba(14,165,233,.16),transparent 28%),linear-gradient(135deg,rgba(255,255,255,.98),rgba(236,253,245,.95));border-color:rgba(15,118,110,.14)}.content-center-main{margin-top:16px}.content-center-guest{margin-top:16px;display:flex;justify-content:space-between;gap:20px;align-items:flex-end}.content-center-guest-copy h3{margin:8px 0 0;font-size:28px;color:var(--text)}.content-center-guest-copy p:last-child{margin:10px 0 0;max-width:720px;color:var(--muted);line-height:1.8}.content-center-panel{margin-top:14px}.content-center-head{display:flex;justify-content:space-between;gap:14px;align-items:flex-start;margin-bottom:16px}.content-center-tabs{display:flex;flex-wrap:wrap;gap:10px;padding:8px;border-radius:22px;background:rgba(241,245,249,.92);border:1px solid rgba(226,232,240,.88);box-shadow:inset 0 1px 0 rgba(255,255,255,.55)}.content-center-tab{border:0;border-radius:999px;padding:10px 14px;background:0 0;color:#64748b;font-size:13px;font-weight:800;cursor:pointer;transition:transform .18s ease,color .18s ease,background .18s ease,box-shadow .18s ease}.content-center-tab:hover{transform:translateY(-1px)}.content-center-tab.active{background:linear-gradient(135deg,rgba(15,1